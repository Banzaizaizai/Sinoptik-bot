# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитить (см. .gitignore).

# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=

# Канал, куда публикуем прогноз. Можно @username (бот должен быть админом канала)
# либо числовой id вида -1001234567890
TELEGRAM_CHANNEL_ID=

# Необязательно: личный chat_id, куда бот пришлёт алерт при сбое парсинга/отправки.
# Получить свой chat_id можно, написав боту @userinfobot.
ADMIN_CHAT_ID=

# Slug города в URL sinoptik.ua (https://sinoptik.ua/pohoda/<CITY_SLUG>)
CITY_SLUG=drohobych
CITY_NAME=Дрогобич

TIMEZONE=Europe/Kyiv

# ---------------------------------------------------------------------------
# Інтерактивний бот (run_interactive.py, systemd: weather-bot-interactive)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN вище використовується і ним. На проді можна той самий токен,
# що й у cron (cron лише викликає sendMessage). На Windows-копії для розробки
# використовуйте ОКРЕМИЙ тестовий токен: два polling-процеси на одному токені
# дають 409 Conflict.

# Обов'язково: chat_id власників через кому. Бот відповідає лише їм і лише в
# приватному чаті. Перший id — основний власник (алерти, стартова локація).
ALLOWED_CHAT_IDS=

# SQLite-база (відносний шлях — від кореня проєкту)
BOT_DB_PATH=data/bot.sqlite3

# Час життя кешу прогнозів, секунд
CACHE_TTL_SEC=600

# Кнопка «Меню бота» под постами канала (deep link в личку). Пусто — без кнопки.
BOT_USERNAME=mysinoptikweather_bot
