# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитить (см. .gitignore).

# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=

# Канал, куда публикуем прогноз. Можно @username (бот должен быть админом канала)
# либо числовой id вида -1001234567890
TELEGRAM_CHANNEL_ID=

# Необязательно: личный chat_id, куда бот пришлёт алерт при сбое парсинга/отправки.
# Получить свой chat_id можно, написав боту @userinfobot.
ADMIN_CHAT_ID=

# Slug города в URL sinoptik.ua (https://sinoptik.ua/pohoda/<CITY_SLUG>)
CITY_SLUG=drohobych
CITY_NAME=Дрогобич

TIMEZONE=Europe/Kyiv
